
$ set -o pipefail; export RUST_MIN_STACK=4194304; export STWO_JIT_MAX_KERNEL_INSTRS=512; export GB=/workspace/stwo-cairo/stwo_cairo_prover/target/release/gpu_bench; export SN=/workspace/stwo-cairo/gpu_benchmarks/pie/sn; export TENT=/workspace/stwo-cairo/gpu_benchmarks/pie/cairo_pie_10_transfers_with_6_ecop.zip; export OUT=/workspace/out; STWO_CUDA_WITNESS_JIT_PROVE=1 STWO_CUDA_DEVICE_INTERACTION=1 STWO_CUDA_PIPELINED_COMMIT=1 STWO_BENCH_TRACE=json STWO_DUMP_PROOF=$OUT/sn2_pc.proof $GB --pie $SN/SN_PIE_2.zip --backend cuda --reps 2 --reuse-input > $OUT/sn2_pc.json 2> $OUT/sn2_pc.err; rc=$?
tail -1 $OUT/sn2_pc.json
grep -q 'A. engaged' $OUT/sn2_pc.err && echo PC_ENGAGED || echo PC_NOT_ENGAGED
a=$(sha256sum $OUT/sn2_off.proof | cut -d' ' -f1)
b=$(sha256sum $OUT/sn2_pc.proof  | cut -d' ' -f1)
if [ "$a" = "$b" ]; then echo PC_PROOF_MATCH; else echo PC_PROOF_DIVERGED; fi
exit $rc
