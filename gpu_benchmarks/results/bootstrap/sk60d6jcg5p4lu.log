  apt-get update -qq && apt-get install -y -qq rsync tmux jq bc >/dev/null; }
command -v cargo >/dev/null 2>&1 || [ -x ~/.cargo/bin/cargo ] || {
  curl -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain none >/dev/null; }
mkdir -p /workspace
echo bootstrap-ok

