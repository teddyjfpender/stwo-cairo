
$ set -o pipefail; export RUST_MIN_STACK=4194304; export STWO_JIT_MAX_KERNEL_INSTRS=2048; export STWO_JIT_CUBIN_CACHE=1; export GB=/workspace/stwo-cairo/stwo_cairo_prover/target/release/gpu_bench; export SN=/workspace/stwo-cairo/gpu_benchmarks/pie/sn; export OUT=/workspace/out; STWO_BENCH_TRACE=json STWO_DUMP_PROOF=$OUT/m5b_on.proof \
  $GB --pie $SN/SN_PIE_2.zip \
  --backend cuda --engine gpu-native --reps 3 --reuse-input 2> $OUT/m5b_on.err \
  > $OUT/m5b_on.json
tail -1 $OUT/m5b_on.json
grep -m1 'A2 engaged' $OUT/m5b_on.err
python3 - <<'PY'
import json
docs=[d for d in (json.loads(l) for l in open('/workspace/out/m5b_on.json') if l.strip().startswith('{')) if 'phase_totals' in d]
t=docs[-1]['phase_totals']
for k in ['Write Base trace','Merkle','Commitment','Compute base trace commitment','Prove STARKs','Evaluate columns out of domain','prove_cairo']:
    if k in t: print(f"span[{k}]={t[k]['total_ms']/1000:.3f}s")
PY
a=$(sha256sum $OUT/m5b_off.proof | cut -d' ' -f1)
b=$(sha256sum $OUT/m5b_on.proof | cut -d' ' -f1)
if [ "$a" = "$b" ]; then echo M5B_PROOF_MATCH; else echo M5B_PROOF_MISMATCH; fi
