
$ set -o pipefail; export RUST_MIN_STACK=4194304; export STWO_JIT_MAX_KERNEL_INSTRS=2048; export STWO_JIT_CUBIN_CACHE=1; export GB=/workspace/stwo-cairo/stwo_cairo_prover/target/release/gpu_bench; export SN=/workspace/stwo-cairo/gpu_benchmarks/pie/sn; export OUT=/workspace/out; STWO_MERKLE_SPANS=1 $GB --pie $SN/SN_PIE_2.zip --backend cuda --engine gpu-native \
  --reps 2 --reuse-input 2> $OUT/m5b_ms.err | tail -1
python3 - <<'PY'
import re, collections
tot=collections.Counter(); cnt=collections.Counter()
lines=open('/workspace/out/m5b_ms.err').read().splitlines()
# keep only the LAST rep's spans (after the last 'rep=' marker if present)
for l in lines:
    m=re.match(r'merkle_span\[(\w+)\]: cols=(\d+) log=(\d+) ms=([0-9.]+)', l)
    if m:
        key=f"{m.group(1)}/log{m.group(3)}" if m.group(1)=='leaves' else m.group(1)
        tot[key]+=float(m.group(4)); cnt[key]+=1
for k,v in sorted(tot.items(), key=lambda x:-x[1])[:14]:
    print(f"merkle[{k}]: {v:.1f}ms over {cnt[k]} calls (2 reps)")
PY
